# =============================================================================
# SizeOK Backend (.env.example)
# Copy this file to `.env` for local overrides (never commit `.env` to Git).
# =============================================================================

# Server port
PORT=8080

# Database Configuration
# Default (if unset): embedded file-backed H2 in PostgreSQL compatibility mode
# Uncomment below to connect to local Docker PostgreSQL (`docker compose up -d`)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/sizeok
# SPRING_DATASOURCE_USERNAME=sizeok
# SPRING_DATASOURCE_PASSWORD=sizeok_dev_password
# SPRING_DATASOURCE_DRIVER=org.postgresql.Driver

# Docker Compose PostgreSQL credentials
POSTGRES_DB=sizeok
POSTGRES_USER=sizeok
POSTGRES_PASSWORD=sizeok_dev_password

# JWT Authentication Secret (must be at least 256 bits / 64 hex characters)
SIZEOK_JWT_SECRET=f9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c8d7e6f5a4b3c2d1e0f9a8
